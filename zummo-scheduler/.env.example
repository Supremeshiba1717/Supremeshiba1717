# ---------------------------------------------------------------------------
# Zummo Bike Scheduling Bot — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# SQLite file path (relative to project root) or any SQLAlchemy URL.
DATABASE_URL=sqlite:///./zummo.db

# --- Twilio (SMS) -----------------------------------------------------------
# For local dev you can use Twilio's "magic" test credentials, which exercise
# the API without sending real texts or incurring charges. Note: test creds
# CANNOT deliver to a real phone. To actually receive a text on your phone,
# use a real Twilio trial account + a verified number instead.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# The Twilio phone number that sends/receives texts (E.164 format, e.g. +15005550006).
TWILIO_FROM_NUMBER=+15005550006
# Set true while using Twilio test credentials to skip signature validation
# on inbound webhooks (test creds don't produce valid signatures locally).
TWILIO_TEST_MODE=true

# --- Manager (Steve) --------------------------------------------------------
# The phone number that receives draft schedules and sends approvals/revisions.
MANAGER_NAME=Steve
MANAGER_PHONE_NUMBER=+15551234567

# --- LLM (Anthropic) --------------------------------------------------------
# NOTE: This is metered pay-per-token billing, NOT covered by any Claude
# consumer subscription. Cost is trivial at this scale (~cents/week) but real.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Cheapest capable model for short structured extraction.
LLM_MODEL=claude-haiku-4-5-20251001

# --- ConnecTeam (stubbed — no real creds yet) -------------------------------
# Leave blank until you have real API access. The stub adapter is used when
# this is empty.
CONNECTEAM_API_KEY=
CONNECTEAM_BASE_URL=

# --- Scheduling / cycle timing ----------------------------------------------
# Weekly kickoff (when availability-request texts go out). Cron-style.
# Default: Tuesday 20:00 (8pm). Day-of-week: 0=Mon ... 6=Sun.
CYCLE_KICKOFF_DAY_OF_WEEK=1
CYCLE_KICKOFF_HOUR=20
CYCLE_KICKOFF_MINUTE=0
# Timezone for the scheduler (IANA name).
TIMEZONE=America/New_York

# Hours after kickoff before a reminder is sent to non-responders.
REMINDER_OFFSET_HOURS=24
# Hours after kickoff before non-responders are marked no_response (hard cutoff).
RESPONSE_CUTOFF_HOURS=48
# Don't re-nudge the same non-responder more than once per this many hours.
NONRESPONDER_COOLDOWN_HOURS=6

# --- Shift-offer (revision loop) --------------------------------------------
# Default number of extra people to add when Steve says "more people" w/o a count.
DEFAULT_OFFER_COUNT=1
# Hours a shift offer stays open before it expires and cascades to next candidate.
OFFER_TIMEOUT_HOURS=2
# Max candidates to try per day before escalating back to Steve.
MAX_OFFER_ATTEMPTS=5

# --- App / hosting ----------------------------------------------------------
# Public base URL where this app is reachable (used to build PDF media links
# for MMS). e.g. https://abc123.ngrok.io  — leave blank for local text-only.
PUBLIC_BASE_URL=
